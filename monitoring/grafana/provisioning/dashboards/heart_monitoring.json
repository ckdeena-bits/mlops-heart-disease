{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Total Prediction Requests by Risk Level",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (risk_level) (heart_prediction_requests_total)",
          "legendFormat": "{{risk_level}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "API Request Rate (req/sec)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m]))",
          "legendFormat": "HTTP Requests"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "Model Prediction Latency (p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(heart_prediction_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 Latency (s)"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "Average Prediction Confidence",
      "type": "stat",
      "targets": [
        {
          "expr": "sum(rate(heart_prediction_confidence_histogram_sum[1m])) / sum(rate(heart_prediction_confidence_histogram_count[1m]))",
          "legendFormat": "Avg Confidence"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["mlops", "heart-disease"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Heart Disease MLOps Monitoring Dashboard",
  "version": 1
}
