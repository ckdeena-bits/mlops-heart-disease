# Set default behavior, in case people don't have core.autocrlf set.
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.csv text eol=lf
*.toml text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf

# Binary files
*.joblib binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.docx binary
*.parquet binary
